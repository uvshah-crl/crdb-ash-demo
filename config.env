# ============================================================
# ASH Demo — Cluster & Workload Configuration
# ============================================================
# This file is sourced by all scripts. Edit values here before
# running the demo.
# ============================================================

# ---- Deploy mode ----
# "roachprod" = remote AWS cluster via roachprod
# "docker"   = local Docker/Podman Compose cluster
DEPLOY_MODE="roachprod"

# ---- Cluster ----
CLOUD="aws"
CRDB_VERSION="v26.2.0"
NUM_NODES=3
AWS_MACHINE_TYPE="m5d.2xlarge"
CLUSTER_LIFETIME="240h"

# ---- Workload defaults ----
WORKLOAD_CONCURRENCY=8
WORKLOAD_DURATION_SECONDS=1800
